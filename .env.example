# App
APP_ENV=development
LOG_LEVEL=DEBUG
CORS_ORIGINS=*

# Database
# 默认使用 SQLite，本地开发开箱即用。
DATABASE_URL=sqlite+aiosqlite:///./aifiction.db

# 如果要改成 PostgreSQL，可使用 docker-compose.postgres.yml。
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aifiction_dev

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# LLM API Keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Gemini 配置字段已预留；当前默认 LLM 适配优先使用 OpenAI 兼容接口、DeepSeek 和 Claude。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
